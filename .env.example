# Supabase — safe to expose to the browser (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Notion API token and Supabase service role key are NOT app env vars.
# They are used only by the notion-sync Supabase Edge Function
# (supabase/functions/notion-sync) and are configured via:
#   npx supabase secrets set NOTION_API_TOKEN=... NOTION_DOMAINS_DATA_SOURCE_ID=... NOTION_USE_CASES_DATA_SOURCE_ID=...
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected into Edge Functions
# by Supabase and never need to be set manually.
